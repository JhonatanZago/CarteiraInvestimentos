{
  "info": {
    "name": "Carteira de Investimentos - Aula 14 RBAC",
    "description": "Cenarios de autenticacao, RBAC e ownership sem credenciais reais.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "thirdPartyPortfolioId", "value": "" },
    { "key": "testEmail", "value": "usuario.rbac@example.com" },
    { "key": "testPassword", "value": "SenhaAcademica123!" }
  ],
  "item": [
    {
      "name": "Login USER - captura token",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"senha\": \"{{testPassword}}\",\n  \"manterConectado\": false\n}" },
        "url": "{{baseUrl}}/api/v1/auth/login"
      },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Login USER retorna 200', function () { pm.response.to.have.status(200); });", "const body = pm.response.json(); pm.expect(body.accessToken).to.be.a('string').and.not.empty; pm.collectionVariables.set('accessToken', body.accessToken);"] } }]
    },
    {
      "name": "Sem token - admin",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/v1/admin/usuarios" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Sem token retorna 401', function () { pm.response.to.have.status(401); });"] } }]
    },
    {
      "name": "USER acessando ADMIN",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/admin/usuarios" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('USER recebe 403', function () { pm.response.to.have.status(403); });"] } }]
    },
    {
      "name": "ADMIN lista usuarios",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/admin/usuarios" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('ADMIN recebe 200', function () { pm.response.to.have.status(200); });", "pm.expect(pm.response.text()).not.to.match(/senha|password|tokenHash/i);"] } }]
    },
    {
      "name": "USER consulta proprio usuario",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/auth/me" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('USER consulta proprio usuario com 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "USER lista proprias carteiras",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/carteiras?page=0&size=20" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('USER lista carteiras com 200', function () { pm.response.to.have.status(200); });"] } }]
    },
    {
      "name": "USER acessa carteira de terceiro",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }], "url": "{{baseUrl}}/api/v1/carteiras/{{thirdPartyPortfolioId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('Ownership de USER retorna 404', function () { pm.response.to.have.status(404); });"] } }]
    },
    {
      "name": "ADMIN acessa carteira privada de terceiro",
      "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }], "url": "{{baseUrl}}/api/v1/carteiras/{{thirdPartyPortfolioId}}" },
      "event": [{ "listen": "test", "script": { "exec": ["pm.test('ADMIN nao contorna ownership e recebe 404', function () { pm.response.to.have.status(404); });"] } }]
    }
  ]
}
